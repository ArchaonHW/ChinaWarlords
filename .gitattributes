# Auto-detect text files and normalize to LF in the repository
* text=auto

# Shell scripts must keep LF (shebang breaks with CRLF)
*.sh        text eol=lf
.githooks/* text eol=lf

# Windows-native scripts keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary files
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.fbx       binary
*.glb       binary
*.jar       binary
